# ============================================================
# PressCare 환경변수 예시
# 이 파일을 복사해 .env 를 만들고 값을 채우세요.  (cp .env.example .env)
# .env 는 절대 커밋하지 마세요. 실제 키는 팀 비공개 채널로만 공유합니다.
# ============================================================

# ----- 공통 -----
APP_ENV=development            # development | staging | production
TZ=Asia/Seoul

# ----- Backend (FastAPI) -----
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=                    # 임의의 긴 문자열 (예: python -c "import secrets;print(secrets.token_hex(32))")
JWT_EXPIRE_MINUTES=720

# ----- Database (PostgreSQL) -----
POSTGRES_USER=presscare
POSTGRES_PASSWORD=
POSTGRES_DB=presscare
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://presscare:<password>@localhost:5432/presscare

# ----- Redis (실시간 상태 / 알림 큐) -----
REDIS_URL=redis://localhost:6379/0

# ----- Edge 에이전트 (병상 PC) -----
EDGE_API_BASE_URL=http://localhost:8000/api/v1
EDGE_DEVICE_TOKEN=             # 백엔드에서 발급한 기기 토큰
CAMERA_SOURCE=0                # 웹캠 번호 또는 RTSP 주소 (rtsp://...)
CAMERA_FPS=5                   # 자세 판별엔 초당 5프레임이면 충분
POSE_BACKEND=mediapipe         # mediapipe | yolo  (yolo는 라이선스 확인 전 사용 금지, D-004)
POSE_MODEL_PATH=./models/weights/pose_landmarker.task
SAVE_RAW_FRAMES=false          # 원본 프레임 저장 금지가 기본값 (개인정보, D-002)

# ----- 자세 판별 / 타이머 -----
POSTURE_STABLE_SEC=30          # 같은 자세가 이 시간 이상 이어져야 "자세 변경"으로 확정
POSTURE_MIN_CONFIDENCE=0.6     # 이보다 낮으면 unknown 처리
REPOSITION_INTERVAL_MIN=120    # 체위변경 기준 시간 (분)
REPOSITION_WARNING_MIN=100     # 사전 경고 시점 (분)

# ----- 알림 -----
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:

# ----- Frontend (Vite: VITE_ 로 시작해야 브라우저에서 읽힘. 비밀값 넣지 말 것) -----
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1/ws
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=
