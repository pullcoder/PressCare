# ============================================================
# PressCare 환경변수 예시
# 이 파일을 복사해 .env 를 만들고 값을 채우세요.  (cp .env.example .env)
# .env 는 절대 커밋하지 마세요. 실제 키는 팀 비공개 채널로만 공유합니다.
# ============================================================

# ----- 공통 -----
APP_ENV=development            # development | staging | production
TZ=Asia/Seoul

# ----- Supabase (D-009) -----
# Supabase 대시보드 → Project Settings → API Keys 에서 확인 (Legacy 탭 말고 publishable/secret 탭)
# 로컬 개발(supabase start)이면 `supabase status` 로 출력되는 값을 사용
SUPABASE_URL=                  # Project URL. 예: https://xxxx.supabase.co  (로컬: http://127.0.0.1:54321)
SUPABASE_ANON_KEY=             # publishable 키 (sb_publishable_...). 브라우저용, RLS 적용
SUPABASE_SERVICE_ROLE_KEY=     # ⚠ secret 키 (sb_secret_...). RLS를 무시하므로 backend 에서만 사용, frontend 에 절대 넣지 말 것

# ----- Supabase JWT 검증 (ES256 + JWKS) -----
# 사용자 토큰은 ES256 비대칭 키로 서명된다. backend 는 공개키(JWKS)로만 검증하므로 비밀값이 필요 없다.
# JWKS 주소는 SUPABASE_URL 로 자동 생성: {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# (구 SUPABASE_JWT_SECRET 은 Legacy HS256 용이라 사용하지 않음)

# ----- 개인정보 암호화 (backend 전용, 절대 VITE_ 로 만들지 말 것) -----
# 생성: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# 두 번 실행해서 서로 다른 값을 넣는다. 팀 전원이 같은 값을 써야 함 (한 명이 생성해 공유)
# 키를 잃으면 데이터 복호화 불가 → 안전한 곳에 별도 백업. 운영 환경은 별도 키 생성
FIELD_ENCRYPTION_KEY=          # 휴대폰·주소·연락용 이메일 AES-256-GCM 암호화 키 (32바이트, base64)
BLIND_INDEX_KEY=               # 암호화된 값 검색용 HMAC-SHA256 키 (32바이트, base64)

# ----- Backend (FastAPI) -----
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173   # 프론트 주소. 여러 개면 쉼표로 구분

DEV_MEMORY_STORE=false          # true: 개발 중 Supabase 키가 있어도 임시 메모리 저장소 사용 (테이블 준비 전 시연용)

# ----- Edge 에이전트 (병상 PC) -----
EDGE_API_BASE_URL=http://localhost:8000/api/v1
EDGE_DEVICE_TOKEN=             # 백엔드 실행 후 POST /edge-devices 응답으로 1회만 받음 (DB 에는 해시만 저장)
CAMERA_SOURCE=0                # 웹캠 번호 또는 RTSP 주소 (rtsp://...)
CAMERA_FPS=5                   # 자세 판별엔 초당 5프레임이면 충분
POSE_BACKEND=mediapipe         # mediapipe | yolo  (yolo는 라이선스 확인 전 사용 금지, D-004)
POSE_MODEL=lite                # lite | full | heavy (오른쪽일수록 정확도↑ 속도↓)
POSE_MODEL_PATH=./models/weights/pose_landmarker.task   # MediaPipe Pose Landmarker 문서에서 다운로드 (lite/full/heavy)
SAVE_RAW_FRAMES=false          # 원본 프레임 저장 금지가 기본값 (개인정보, D-002)

# ----- 자세 판별 / 타이머 -----
POSTURE_STABLE_SEC=30          # 같은 자세가 이 시간 이상 이어져야 "자세 변경"으로 확정
POSTURE_MIN_CONFIDENCE=0.6     # 이보다 낮으면 unknown 처리
REPOSITION_INTERVAL_MIN=120    # 체위변경 기준 시간 (분)
REPOSITION_WARNING_MIN=100     # 사전 경고 시점 (분)
EDGE_HEARTBEAT_SEC=60          # 엣지 heartbeat 주기 (초)
EDGE_OFFLINE_SEC=180           # 이 시간 동안 heartbeat 없으면 병상 offline
DEMO_TIME_SCALE=1              # 시연 전용 시간 가속 배수 (1 = 실제 시간). production에서는 무시

# ----- 알림 (D-012) -----
ALERT_CHECK_SEC=3              # 알림 판단 루프 주기 (초). Realtime 전달 시간을 더해도 "알림 지연 ≤ 5초"(PLAN 8장)를 지키도록 5 미만으로 둔다
ALERT_ESCALATE_MIN=5           # critical 알림을 이 시간 동안 아무도 확인하지 않으면 문자 발송

# Web Push: 직접 생성 → npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=     # 출력된 Public Key (VITE_WEB_PUSH_VAPID_PUBLIC_KEY 와 같은 값)
WEB_PUSH_VAPID_PRIVATE_KEY=    # 출력된 Private Key (backend 전용)
WEB_PUSH_SUBJECT=mailto:       # 팀 연락용 이메일, 예: mailto:team@example.com

# SMS: 개발 중엔 none 으로 두고 비워도 됨 (문자 대신 로그만 남김)
SMS_PROVIDER=none              # none | solapi
SMS_API_KEY=                   # 솔라피 콘솔 → API Key 관리
SMS_API_SECRET=                # 솔라피 콘솔 → API Key 관리 (발급 시에만 보이므로 바로 복사)
SMS_SENDER=                    # 솔라피 콘솔 → 발신번호 관리에서 사전 등록한 번호

# ----- Frontend (Vite: VITE_ 로 시작해야 브라우저에서 읽힘. 비밀값 넣지 말 것) -----
# 이 .env 는 저장소 루트 하나만 쓴다. frontend/vite.config.ts 에 envDir: '..' 를 설정해야 읽힌다.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=             # SUPABASE_URL 과 같은 값
VITE_SUPABASE_ANON_KEY=        # publishable 키 (sb_publishable_...). secret 키(sb_secret_...) 절대 금지
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=   # WEB_PUSH_VAPID_PUBLIC_KEY 와 같은 값
